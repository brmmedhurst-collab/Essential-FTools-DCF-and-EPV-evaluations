def epv_valuation(ticker, effective_tax_rate, discount_rate):
    """Calculates EPV intrinsic value per share."""
    stock = yf.Ticker(ticker)

    # --- Fetch EBIT (Operating Income) ---
    ebit = None
    try:
        # yfinance financials sometimes has EBIT, sometimes Operating Income
        for key in ["EBIT", "Operating Income", "OperatingIncome", "Income Before Tax"]:
            if key in stock.financials.index:
                ebit = stock.financials.loc[key][:5].values
                break
    except Exception:
        pass

    if ebit is None:
        print(f" Could not fetch EBIT/Operating Income for {ticker}.")
        return None

    # Clean NaNs
    ebit = [x for x in ebit if not np.isnan(x)]
    if len(ebit) == 0:
        print(f" EBIT data for {ticker} was all NaN.")
        return None

    normalized_ebit = np.mean(ebit)

    # --- Apply Tax Rate ---
    after_tax_ebit = normalized_ebit * (1 - effective_tax_rate)

    # --- Enterprise Value (EPV of operations) ---
    if discount_rate <= 0:
         print(" Discount rate must be positive for EPV calculation.")
         return None
    enterprise_value = after_tax_ebit / discount_rate

    # --- Adjust for Net Debt ---
    # Assuming fetch_debt_and_cash is defined and accessible
    try:
        total_debt, cash, net_debt = fetch_debt_and_cash(ticker)
        if net_debt is None:
             print(f" Could not fetch debt/cash for {ticker}, unable to calculate Equity Value.")
             return None
    except NameError:
         print(" fetch_debt_and_cash function not found. Please ensure it's defined in a previous cell.")
         return None


    equity_value = enterprise_value - net_debt

    # --- Shares Outstanding ---
    shares_outstanding = stock.info.get("sharesOutstanding", None)
    if shares_outstanding is None or shares_outstanding == 0:
        print(f" Could not fetch shares outstanding for {ticker}.")
        return None

    intrinsic_value_per_share = equity_value / shares_outstanding
    return intrinsic_value_per_share


