def calculate_discount_rate(ticker, risk_free_rate, equity_risk_premium):
    """
    Calculate WACC (discount rate) for a company.

    Parameters:
    - ticker: Stock ticker symbol (str)
    - risk_free_rate: Manual input (float, e.g., 0.0434 for 4.34%)
    - equity_risk_premium: Manual input (float, e.g., 0.05 for 5%)

    Returns:
    - WACC as a float
    """
    # Fetch stock data
    stock = yf.Ticker(ticker)

    # Retrieve beta from stock info
    beta = stock.info.get('beta', 1)  # default to 1 if not available

    # Calculate cost of equity using CAPM
    cost_of_equity = risk_free_rate + beta * equity_risk_premium

    # Example cost of debt and tax rate (these could be dynamically fetched too)
    cost_of_debt = 0.04  # 4%
    tax_rate = 0.21      # 21%

    # Market values
    market_cap = stock.info.get('marketCap', 1)    # default 1 if not available
    total_debt = stock.info.get('totalDebt', 0)    # default 0 if not available
    total_value = market_cap + total_debt

    # WACC calculation
    wacc = ((market_cap / total_value) * cost_of_equity) + ((total_debt / total_value) * cost_of_debt * (1 - tax_rate))

    return wacc

def fetch_fcf(stock, years=5):
    # Try multiple possible Free Cash Flow labels
    fcf_labels = ['Free Cash Flow', 'FreeCashFlow', 'FCF']
    fcf_history = None

    for label in fcf_labels:
        try:
            fcf_history = stock.cashflow.loc[label][:years].values[::-1]
            if not np.isnan(fcf_history).all():
                return fcf_history
        except KeyError:
            continue

    # Fallback: Operating Cash Flow - Capital Expenditures
    ocf_labels = ['Total Cash From Operating Activities', 'Operating Cash Flow', 'NetCashProvidedByOperatingActivities']
    capex_labels = ['Capital Expenditures', 'CapEx', 'PaymentsForPropertyPlantAndEquipment']

    for ocf_label in ocf_labels:
        for capex_label in capex_labels:
            try:
                ocf = stock.cashflow.loc[ocf_label][:years].values[::-1]
                capex = stock.cashflow.loc[capex_label][:years].values[::-1]
                fcf_history = ocf - capex
                if not np.isnan(fcf_history).all():
                    return fcf_history
            except KeyError:
                continue

    # If still nothing, return NaNs
    return np.array([np.nan]*years)


def estimate_terminal_growth(ticker, method="hybrid", gdp_growth=None, inflation=None):
    stock = yf.Ticker(ticker)

    # Try to get Free Cash Flow
    try:
        fcf_history = fetch_fcf(stock, years=4)
    except KeyError:
        try:
            # fallback: Operating Cash Flow - Capital Expenditures
            ocf = stock.cashflow.loc['Total Cash From Operating Activities'][:5].values[::-1]
            capex = stock.cashflow.loc['Capital Expenditures'][:5].values[::-1]
            fcf_history = ocf - capex
        except KeyError:
            fcf_history = np.array([np.nan]*5)

    # Check for NaN or insufficient data
    if np.isnan(fcf_history).any() or len(fcf_history) < 2:
        print("Could not fetch valid Free Cash Flow data for historical growth calculation.")
        print("Please manually input the last 5 years of FCF (oldest to newest) for historical growth:")
        fcf_input = input("Enter 5 FCF values separated by commas: ")
        fcf_history = np.array([float(x.strip()) for x in fcf_input.split(",")])

    # Average historical growth
    hist_growth = np.mean([(fcf_history[i+1]-fcf_history[i])/fcf_history[i]
                           for i in range(len(fcf_history)-1)])

    # Ask for GDP growth and inflation if not provided
    if gdp_growth is None:
        gdp_growth = float(input("Enter expected long-term GDP growth (as decimal, e.g., 0.025 for 2.5%): "))
    if inflation is None:
        inflation = float(input("Enter expected long-term inflation (as decimal, e.g., 0.02 for 2%): "))


    # Determine terminal growth
    if method == "gdp":
        terminal_growth = gdp_growth + inflation
    elif method == "historical":
        terminal_growth = hist_growth
    elif method == "hybrid":
        terminal_growth = min(hist_growth, gdp_growth + inflation)
    else:
        raise ValueError("Invalid method. Choose 'gdp', 'historical', or 'hybrid'.")

    return terminal_growth


def fetch_latest_fcf(ticker):
    stock = yf.Ticker(ticker)
    try:
        fcf = stock.cashflow.loc['Free Cash Flow'][0]  # most recent year
        if np.isnan(fcf):
            raise KeyError
        return fcf
    except KeyError:
        try:
            ocf = stock.cashflow.loc['Total Cash From Operating Activities'][0]
            capex = stock.cashflow.loc['Capital Expenditures'][0]
            return ocf - capex
        except KeyError:
            return float(input(f"Could not fetch FCF automatically for {ticker}. Enter latest FCF: "))

def fetch_net_debt(ticker):
    stock = yf.Ticker(ticker)
    try:
        # Prioritize balance sheet items
        try:
            long_term_debt = stock.balance_sheet.loc['Long Term Debt'][0]
        except KeyError:
            long_term_debt = 0

        try:
            short_term_debt = stock.balance_sheet.loc['CurrentDebt'][0]
        except KeyError:
             short_term_debt = 0

        try:
             cash = stock.balance_sheet.loc['Cash'][0]
        except KeyError:
             cash = 0 # Assume no cash if not available

        total_debt = long_term_debt + short_term_debt
        return total_debt - cash

    except KeyError:
         print(f"Could not fetch Net Debt automatically for {ticker}. Attempting from financials...")
         try:
             # Fallback to income statement items if balance sheet fails
             total_liabilities = stock.financials.loc['Total Liabilities'][0] # This is not ideal for net debt, but a rough proxy if balance sheet is missing
             total_assets = stock.financials.loc['Total Assets'][0]
             # This is a very rough estimate and should be used with caution
             return total_liabilities - total_assets # This is incorrect net debt calculation, but a placeholder

         except KeyError:
              return float(input(f"Could not fetch Net Debt automatically for {ticker}. Enter Net Debt: "))


