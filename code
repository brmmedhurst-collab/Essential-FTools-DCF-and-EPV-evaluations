def estimate_growth_rate_historical(ticker, years=5):
    stock = yf.Ticker(ticker)

    # Try to fetch FCF
    try:
        fcf = stock.cashflow.loc['Free Cash Flow'][:years].values[::-1]
    except KeyError:
        try:
            ocf = stock.cashflow.loc['Total Cash From Operating Activities'][:years].values[::-1]
            capex = stock.cashflow.loc['Capital Expenditures'][:years].values[::-1]
            fcf = ocf - capex
        except KeyError:
            # print(" Could not fetch Free Cash Flow for historical growth calculation.") # Commenting out to reduce clutter
            return None

    # Remove NaN values
    fcf = fcf[~np.isnan(fcf)]

    if len(fcf) < 2:
        # print(" Not enough data for historical growth calculation.") # Commenting out to reduce clutter
        return None

    # Calculate CAGR
    start, end = fcf[0], fcf[-1]
    n_years = len(fcf) - 1

    if start <= 0 or end <= 0:  # avoid negative FCF issues
        # print(" FCF has negative values, CAGR may be misleading for historical growth.") # Commenting out
        # Use mean percentage change for negative values
        growth_rate = np.mean([(fcf[i+1] - fcf[i]) / abs(fcf[i]) if fcf[i] != 0 else 0 for i in range(len(fcf)-1)])
    else:
        # Handle potential domain error if end/start is negative
        try:
            growth_rate = (end / start) ** (1 / n_years) - 1
        except ValueError:
             # print(" Cannot calculate CAGR due to negative values. Using mean percentage change for historical growth.") # Commenting out
             growth_rate = np.mean([(fcf[i+1] - fcf[i]) / abs(fcf[i]) if fcf[i] != 0 else 0 for i in range(len(fcf)-1)])


    return growth_rate

def estimate_growth_rate_analyst(ticker):
    """
    Estimates future growth rate using analyst consensus estimates from yfinance.
    Returns the estimated annual earnings growth rate as a float, or None if unavailable.
    """
    stock = yf.Ticker(ticker)

    try:
        # yfinance stores analyst estimates in the 'info' attribute
        # 'earningsGrowth' is a common key for future annual growth estimate
        growth_estimate = stock.info.get('earningsGrowth', None)

        if growth_estimate is not None:
            return float(growth_estimate)
        else:
            # print(f" Could not find analyst earnings growth estimates for {ticker}.") # Commenting out to avoid excessive output
            return None

    except Exception as e:
        print(f" An error occurred while fetching analyst estimates for {ticker}: {e}")
        return None


def _find_row_case_insensitive(df, candidates):
    """Return a pandas Series for the first matching row (exact or substring), or None."""
    if df is None or df.empty:
        return None
    idx = [str(i).lower() for i in df.index.astype(str)]
    # Exact match first
    for cand in candidates:
        cand_l = cand.lower()
        for i, lab in enumerate(idx):
            if lab == cand_l:
                return df.iloc[i]
    # Then substring matches
    for cand in candidates:
        cand_l = cand.lower()
        for i, lab in enumerate(idx):
            if cand_l in lab:
                return df.iloc[i]
    return None


def fetch_effective_tax_rate(ticker, years=3, fallback=0.21, prompt_if_missing=True, verbose=False):
    """
    Attempts to compute the effective tax rate = Income Tax Expense / Income Before Tax
    using a few years of values (annual first, then quarterly). Returns a float (0-1).
    If it fails, optionally prompts for manual input or returns fallback.
    """
    stock = yf.Ticker(ticker)

    # candidate labels (common variants)
    pretax_candidates = [
        'Income Before Tax', 'Pretax Income', 'Income Before Income Taxes',
        'Earnings Before Tax', 'Income (Loss) Before Income Taxes', 'Pre-Tax Income'
    ]
    tax_candidates = [
        'Income Tax Expense', 'Provision for Income Taxes', 'Income Tax (Expense) Benefit',
        'Income Taxes', 'Provision For Income Taxes', 'Income Tax'
    ]

    rates = []

    # Try annual financials first, then quarterly
    for df_name in ('financials', 'quarterly_financials'):
        try:
            df = getattr(stock, df_name)
        except Exception:
            df = None

        if df is None or (isinstance(df, pd.DataFrame) and df.empty):
            if verbose:
                print(f"No {df_name} data.")
            continue

        pretax_row = _find_row_case_insensitive(df, pretax_candidates)
        tax_row = _find_row_case_insensitive(df, tax_candidates)

        if pretax_row is None or tax_row is None:
            if verbose:
                print(f"Could not match pretax/tax rows in {df_name}.")
            continue

        # Take up to `years` most recent columns (yfinance columns are usually in descending date order)
        n_cols = min(years, pretax_row.size, tax_row.size)
        pretax_vals = pretax_row.iloc[:n_cols].values.astype(float)
        tax_vals = tax_row.iloc[:n_cols].values.astype(float)

        # compute per-period rates, skip invalid periods
        for pt, tx in zip(pretax_vals, tax_vals):
            if np.isnan(pt) or np.isnan(tx):
                continue
            if abs(pt) < 1e-8:  # pretax is zero -> skip
                continue
            rate = tx / pt
            # sanity filter: typical meaningful tax rates between -0.5 and 1.0 (allow negative sometimes)
            if -0.5 <= rate <= 1.5:
                rates.append(rate)

        if rates:
            # if we found any in this df, stop (annual preferred over quarterly since we loop annual first)
            break

    if rates:
        avg_rate = float(np.mean(rates))
        if verbose:
            print(f"Found {len(rates)} valid year(s) of tax rates, average = {avg_rate:.4f}")
        return avg_rate

    # Nothing valid found — fallback
    if prompt_if_missing:
        s = input(f"Could not auto-calc effective tax rate for {ticker}. Enter effective tax rate as decimal (or press Enter to use fallback {fallback}): ").strip()
        if s != "":
            try:
                val = float(s)
                return val
            except ValueError:
                print("Invalid input — using fallback.")
    if verbose:
        print(f"Using fallback tax rate = {fallback:.2f}")
    return fallback


# --- Debt & Cash Fetcher (safe) ---
def fetch_debt_and_cash(ticker):
    stock = yf.Ticker(ticker)
    info = stock.info or {}

    # Grab from .info first
    total_debt = info.get("totalDebt") or info.get("longTermDebt") or None
    cash = info.get("totalCash") or info.get("cashAndShortTermInvestments") or None

    # Fallback: try balance sheet
    try:
        bs = stock.balance_sheet
        if not bs.empty:
            recent = bs.iloc[:, 0]  # most recent col
            if total_debt is None:
                for key in ["Total Debt", "Long Term Debt", "Short Long Term Debt", "Short Term Debt"]:
                    if key in recent.index:
                        val = recent[key]
                        if not np.isnan(val):
                            total_debt = float(val)
                            break
            if cash is None:
                for key in ["Cash", "Cash And Cash Equivalents", "Cash And Short Term Investments"]:
                    if key in recent.index:
                        val = recent[key]
                        if not np.isnan(val):
                            cash = float(val)
                            break
    except Exception:
        pass

    # If still missing → None
    if total_debt is None or np.isnan(total_debt):
        total_debt = 0.0
    if cash is None or np.isnan(cash):
        cash = 0.0

    net_debt = total_debt - cash
    return total_debt, cash, net_debt


